\@writefile{toc}{\contentsline {subsection}{\numberline {A.1}The comparative analysis of SI probabilistic forecasting and conditional diffusion models}{5}{subsection.A.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Forecasting the five-mode Gaussian-mixture jump-diffusion of \cite  {chen2024forecasting} at lags $\tau \in \{0.5,1,2\}$ (columns). All models share one MLP ($3\times 128$, SiLU) trained with Adam for 15k steps on $10^5$ stationary pairs; every sampler uses $K$ network evaluations (NFE) on a uniform time grid. SI-SDE and SI-F\"ollmer sample the same learned interpolant drift from $X_0=x_0$ with noise $\sigma _s$ or the F\"ollmer coefficient $g^{\mathrm  F}_s$; Diff-SDE and Diff-DDIM sample a VP conditional diffusion model of $x_1$ from Gaussian noise with the reverse SDE or DDIM; the \emph  {-resid} variants model the normalized increment $(x_1-x_0)/c$. Forecasts (2{,}000 per initial condition) are compared with $2\times 10^4$ simulated paths from four initial conditions: a mode centre, between two modes, near the origin, and an outer tail. \textbf  {Top:} sliced $W_1$ distance. \textbf  {Middle:} total-variation error in the probability of landing in each mode (nearest of five angular sectors). Curves are means over initial conditions; bands show $\pm 1$ s.d.\ over 3 seeds; gray lines are the Monte Carlo floor, i.e.\ the score of exact samples of the same size. \textbf  {Bottom:} fraction of forecasts at $K=100$ lying between modes; dashed line: exact forecasts; error bars: $\pm 1$ s.d.\ over seeds.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig1}{{1}{5}{Forecasting the five-mode Gaussian-mixture jump-diffusion of \cite {chen2024forecasting} at lags $\tau \in \{0.5,1,2\}$ (columns). All models share one MLP ($3\times 128$, SiLU) trained with Adam for 15k steps on $10^5$ stationary pairs; every sampler uses $K$ network evaluations (NFE) on a uniform time grid. SI-SDE and SI-F\"ollmer sample the same learned interpolant drift from $X_0=x_0$ with noise $\sigma _s$ or the F\"ollmer coefficient $g^{\mathrm F}_s$; Diff-SDE and Diff-DDIM sample a VP conditional diffusion model of $x_1$ from Gaussian noise with the reverse SDE or DDIM; the \emph {-resid} variants model the normalized increment $(x_1-x_0)/c$. Forecasts (2{,}000 per initial condition) are compared with $2\times 10^4$ simulated paths from four initial conditions: a mode centre, between two modes, near the origin, and an outer tail. \textbf {Top:} sliced $W_1$ distance. \textbf {Middle:} total-variation error in the probability of landing in each mode (nearest of five angular sectors). Curves are means over initial conditions; bands show $\pm 1$ s.d.\ over 3 seeds; gray lines are the Monte Carlo floor, i.e.\ the score of exact samples of the same size. \textbf {Bottom:} fraction of forecasts at $K=100$ lying between modes; dashed line: exact forecasts; error bars: $\pm 1$ s.d.\^^Mover seeds}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.2}Mixed 2D Stochastic Navier-Stokes and Burger}{5}{subsection.A.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The enstrophy spectra one lag agead ($\tau =1$) with interpolants $\alpha _s=1-s$, $\beta _s=s^2$, $\sigma _s=1-s$ and chosen so the diffusion term is $\sigma _sdW_s.$ Each is compared to the ground truth and a deterministic version. Over $6$ $\omega _t$ and $16$ independent ensembles of the forecast results $\hat  \omega _{t+\tau }$ are averaged over to create the spectrum. \textbf  {Top:} The enstrophy spectra of the model using a dataset with a 50:50 mixture of NSE and Burgers data. \textbf  {Bottom:} On the left, the enstropy spectrum of the model trained on only NSE and on the right, the enstropy spectrum of the model trained on only Burger's equation. Generally, the performance of the mixed dataset is worse than that of the homogeneous datasets, especially around peaks.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:enstrophy}{{2}{6}{The enstrophy spectra one lag agead ($\tau =1$) with interpolants $\alpha _s=1-s$, $\beta _s=s^2$, $\sigma _s=1-s$ and chosen so the diffusion term is $\sigma _sdW_s.$ Each is compared to the ground truth and a deterministic version. Over $6$ $\omega _t$ and $16$ independent ensembles of the forecast results $\hat \omega _{t+\tau }$ are averaged over to create the spectrum. \textbf {Top:} The enstrophy spectra of the model using a dataset with a 50:50 mixture of NSE and Burgers data. \textbf {Bottom:} On the left, the enstropy spectrum of the model trained on only NSE and on the right, the enstropy spectrum of the model trained on only Burger's equation. Generally, the performance of the mixed dataset is worse than that of the homogeneous datasets, especially around peaks}{figure.2}{}}
\newlabel{eq:noise_construction}{{1}{6}{Mixed 2D Stochastic Navier-Stokes and Burger}{equation.1}{}}
\newlabel{eq:noise_construction_burgers}{{2}{6}{Mixed 2D Stochastic Navier-Stokes and Burger}{equation.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Comparisons between the SDE approach and deterministic approach across the different datasets are shown of the short-time and long-time relative accuracy and the long-time of enstrophy. For the long-time row, the models are iterated for $20$ lags $\tau =1$ from $6$ held-out starts. The SDE model for Navier-Stokes does worse in the mixed sets, though Burgers performs slightly better with a 50:50 mixture.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:errors}{{1}{7}{Comparisons between the SDE approach and deterministic approach across the different datasets are shown of the short-time and long-time relative accuracy and the long-time of enstrophy. For the long-time row, the models are iterated for $20$ lags $\tau =1$ from $6$ held-out starts. The SDE model for Navier-Stokes does worse in the mixed sets, though Burgers performs slightly better with a 50:50 mixture}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparison on the AdvDiff1D stream. Lower values are better. Replay achieves the lowest final stream MSE and relative $L^2$ error in this fast diagnostic run.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:cl-smoke-comparison}{{3}{7}{Comparison on the AdvDiff1D stream. Lower values are better. Replay achieves the lowest final stream MSE and relative $L^2$ error in this fast diagnostic run}{figure.3}{}}
